{
  "display_information": {
    "display_name": "Callie",
    "discover_type": "LISTED",
    "install_type": "APP_DIRECTORY"
  },
  "oauth_information": {
    "usage": "USER_OPERATION",
    "development_redirect_uri": "http://127.0.0.1/",
    "production_redirect_uri": "http://127.0.0.1/",
    "oauth_allow_list": ["http://127.0.0.1/"],
    "strict_mode": false,
    "subdomain_strict_mode": false,
    "scopes": [
      {
        "scope": "meeting:write:meeting",
        "optional": false
      },
      {
        "scope": "user:read:user",
        "optional": false
      }
    ],
    "scope_description": "Callie makes a Zoom meeting when the user turns on the video call switch for a calendar event, and adds its join link to the event. meeting:write:meeting creates that meeting; user:read:user shows which Zoom account is connected. Nothing else is read or changed.",
    "enable_private_pkce_client": true,
    "enable_public_pkce_client": true
  },
  "developer_information": {
    "contact_details": [
      {
        "contact_name": "Greylock Labs",
        "contact_email": "hello@greylocklabs.org",
        "role": "Owner"
      }
    ]
  },
